// GitLab remains the reference until equivalence is demonstrated on Jenkins.
properties([disableConcurrentBuilds(), buildDiscarder(logRotator(daysToKeepStr: '30'))])

node('ksp-tools') {
    timeout(time: 60, unit: 'MINUTES') {
        try {
            stage('Checkout') {
                deleteDir()
                checkout scm
                sh 'python3 jenkins/scripts/prepare-artifacts.py framework'
            }

            stage('Validate') {
                sh 'bash jenkins/scripts/validate.sh'
                sh 'bash jenkins/scripts/check-policy.sh'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh 'python3 jenkins/scripts/harbor-check.py > artifacts/validate/harbor-auth.txt'
                }
            }

            stage('CLI Unit Test') {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh 'bash jenkins/scripts/with-harbor.sh bash jenkins/scripts/cli-unit.sh'
                }
            }

            stage('Rendered Policy Test') {
                sh 'bash jenkins/scripts/rendered-policy-test.sh'
            }

        } finally {
            stage('Collect Results') {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    if (fileExists('jenkins/scripts/collect-results.sh')) {
                        sh 'bash jenkins/scripts/collect-results.sh'
                    }
                }
            }

            stage('Archive Artifacts') {
                archiveArtifacts(
                    artifacts: 'artifacts/validate/**,artifacts/check-policy/**,artifacts/cli-unit/**,artifacts/rendered-policy-test/**,artifacts/report/**',
                    allowEmptyArchive: true
                )

                junit(
                    testResults: 'artifacts/cli-unit/junit/*.xml',
                    allowEmptyResults: true
                )
            }
        }
    }
}
