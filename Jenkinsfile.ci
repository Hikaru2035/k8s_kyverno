// GitLab remains the reference until equivalence is demonstrated on Jenkins.
properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(daysToKeepStr: '30')),
    parameters([choice(name: 'POLICY_ENVIRONMENT',
        choices: ['development', 'staging', 'production'],
        description: 'Render, test, and package one policy environment')])
])

node('ksp-tools') {
    timeout(time: 60, unit: 'MINUTES') {
        def approvedPolicies = false
        def policyEnvironment = params.POLICY_ENVIRONMENT ?: 'development'
        if (!(policyEnvironment in ['development', 'staging', 'production'])) {
            error('Invalid POLICY_ENVIRONMENT')
        }
        env.POLICY_ENVIRONMENT = policyEnvironment
        try {
            stage('Checkout') {
                deleteDir()
                checkout scm
                dir("artifacts/approved-policies-${policyEnvironment}") { deleteDir() }
                sh 'python3 jenkins/scripts/prepare-artifacts.py framework'
            }

            stage('Validate') {
                sh 'bash jenkins/scripts/validate.sh'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh 'python3 jenkins/scripts/harbor-check.py > artifacts/validate/harbor-auth.txt'
                }
            }

            stage('CLI Unit Test') {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh 'bash jenkins/scripts/with-harbor.sh bash jenkins/scripts/cli-unit.sh'
                }
            }

            stage('Rendered Policy Test') {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh 'bash jenkins/scripts/with-harbor.sh bash jenkins/scripts/rendered-policy-test.sh'
                }
            }

            stage('Package Approved Policies') {
                sh 'bash jenkins/scripts/package-approved-policies.sh'
                approvedPolicies = true
            }

        } finally {
            stage('Collect Results') {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    if (fileExists('jenkins/scripts/collect-results.sh')) {
                        sh 'bash jenkins/scripts/collect-results.sh'
                    }
                }
            }

            stage('Archive Artifacts') {
                archiveArtifacts(
                    artifacts: 'artifacts/validate/**,artifacts/check-policy/**,artifacts/cli-unit/**,artifacts/rendered-policy-test/**,artifacts/report/**' +
                        (approvedPolicies ? ",artifacts/approved-policies-${policyEnvironment}/**" : ''),
                    allowEmptyArchive: true
                )

                junit(
                    testResults: 'artifacts/cli-unit/junit/*.xml',
                    allowEmptyResults: true
                )
            }
        }
    }
}
